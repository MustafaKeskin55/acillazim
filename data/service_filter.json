{
  "field_definitions": {
    "quick_action": {
      "label": "Hızlı İşlem Seçimi",
      "description": "Müşterileriniz hızlıca işlem başlatabilsin mi?",
      "type": "toggle",
      "db_field": "quick_action_enabled"
    },
    "service_description": {
      "label": "Hizmet Açıklaması",
      "description": "Hizmetinizi detaylıca açıklayın",
      "type": "textarea",
      "db_field": "service_description",
      "required": true,
      "min_length": 50,
      "max_length": 2000
    },
    "portfolio_gallery": {
      "label": "Portföy Galerisi",
      "description": "Yaptığınız işlerden örnekler ekleyin",
      "type": "gallery",
      "db_field": "portfolio_images",
      "max_files": 20,
      "accepted_types": ["image/jpeg", "image/png", "image/webp"]
    },
    "service_areas": {
      "label": "Hizmet Bölgeleri",
      "description": "Hangi illerde/ilçelerde hizmet veriyorsunuz?",
      "type": "multi-location",
      "db_field": "service_areas"
    },
    "working_hours": {
      "label": "Çalışma Saatleri",
      "description": "Haftalık çalışma saatlerinizi girin",
      "type": "working_hours",
      "db_field": "working_hours"
    },
    "certificates": {
      "label": "Sertifikalar",
      "description": "Sertifikanız varsa ekleyin",
      "type": "certificates",
      "db_field": "certificates",
      "max_files": 10
    },
    "faq": {
      "label": "Sıkça Sorulan Sorular",
      "description": "Müşterilerinizin sıkça sorduğu soruları ekleyin",
      "type": "faq_list",
      "db_field": "faq_items",
      "max_items": 20
    },
    "service_packages": {
      "label": "Hizmet Paketleri",
      "description": "Fiyatlandırma paketlerinizi oluşturun",
      "type": "packages",
      "db_field": "pricing_packages",
      "min_packages": 1,
      "max_packages": 5
    },
    "service_features": {
      "label": "Hizmet Özellikleri",
      "description": "Hizmetinizin özelliklerini seçin",
      "type": "multi_select",
      "db_field": "service_features",
      "max_items": 15
    },
    "about": {
      "label": "Hakkında",
      "description": "Kendinizi ve işinizi tanıtın",
      "type": "textarea",
      "db_field": "about_text",
      "min_length": 20,
      "max_length": 1000
    }
  },
